# Copy to backend/.env (local) or set in your host's environment settings (Render). Never commit real keys.

# --- LLM (AI Mentor, Resume enrichment, education watcher) ---
# auto = first configured key among Gemini, Groq, OpenAI. Or force: gemini | groq | openai
LLM_PROVIDER=auto
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional model overrides
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45

# --- API ---
# Comma-separated origins, or * to allow all
CORS_ORIGINS=*
MAX_UPLOAD_MB=5
