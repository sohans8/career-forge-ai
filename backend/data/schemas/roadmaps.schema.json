{
  "title": "Career Forge AI roadmap graph (JSON Schema draft 7)",
  "type": "object",
  "required": ["schema_version", "last_updated", "stages", "nodes"],
  "properties": {
    "schema_version": {"type": "string"},
    "last_updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "disclaimer": {"type": "string"},
    "stages": {
      "type": "object",
      "required": ["after_10th", "after_12th", "after_diploma"],
      "additionalProperties": {
        "type": "object",
        "required": ["label", "root"],
        "properties": {"label": {"type": "string"}, "root": {"type": "string"}}
      }
    },
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/node"}}
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id", "stage", "kind", "title", "duration", "eligibility", "entrance_exams",
                   "top_branches_or_roles", "next_nodes", "avg_salary_range", "streams", "last_updated"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "stage": {"enum": ["after_10th", "after_12th", "after_diploma"]},
        "kind": {"enum": ["root", "path"]},
        "title": {"type": "string", "minLength": 3},
        "summary": {"type": "string"},
        "duration": {"type": "string"},
        "eligibility": {"type": "string", "minLength": 3},
        "entrance_exams": {"type": "array", "items": {"type": "string"}},
        "top_branches_or_roles": {"type": "array", "items": {"type": "string"}},
        "next_nodes": {"type": "array", "items": {"type": "string"}},
        "avg_salary_range": {"type": "string"},
        "streams": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "college_type": {"enum": ["engineering", "diploma", "pharmacy", "management", null]},
        "branch_keywords": {"type": "array", "items": {"type": "string"}},
        "official_links": {"type": "array", "items": {"type": "string", "pattern": "^https://"}},
        "last_updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    }
  }
}
